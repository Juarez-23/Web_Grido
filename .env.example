# ============================================
# GRIDO SAN RAFAEL - Variables de Entorno
# Copiar a .env.local y completar los valores
# ============================================

# --- BASE DE DATOS ---
# Obtener desde Supabase > Settings > Database > Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"

# --- NEXTAUTH ---
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secreto-super-seguro-aqui"
NEXTAUTH_URL="http://localhost:3000"

# --- MERCADO PAGO ---
# Obtener desde: https://www.mercadopago.com.ar/developers
MP_ACCESS_TOKEN="APP_USR-tu-access-token-de-produccion"
MP_PUBLIC_KEY="APP_USR-tu-public-key"
# URL de tu app en producción (para webhooks)
MP_WEBHOOK_URL="https://tu-app.vercel.app/api/payments/webhook"

# --- WHATSAPP ---
# Número de WhatsApp de la sucursal (sin + ni espacios, con código de país)
WHATSAPP_NUMBER="5492604000000"

# --- SUPABASE STORAGE (para imágenes) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key"

# --- CONFIGURACIÓN DEL NEGOCIO ---
# Costo fijo de delivery en pesos
DELIVERY_COST="1500"
# Pedido mínimo en pesos
MIN_ORDER_AMOUNT="5000"
