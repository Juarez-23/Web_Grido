// ============================================
// GRIDO SAN RAFAEL - Prisma Schema (PostgreSQL)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── SUCURSALES ─────────────────────────────
model Branch {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  active     Boolean     @default(true)
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  categories Category[]
  products   Product[]
  flavors    Flavor[]
  orders     Order[]
  settings   Setting[]
  promotions Promotion[]

  @@map("branches")
}

// ─── USUARIOS ───────────────────────────────
// Role: "ADMIN" (dueño, ve todas) | "EMPLEADO" (solo su sucursal)
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("EMPLEADO")
  active    Boolean  @default(true)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─── CATEGORÍAS ─────────────────────────────
model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String
  icon     String?
  order    Int       @default(0)
  active   Boolean   @default(true)
  branchId String
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([branchId, slug])
  @@unique([branchId, name])
  @@map("categories")
}

// ─── PRODUCTOS ──────────────────────────────
model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?
  maxFlavors  Int         @default(0)
  active      Boolean     @default(true)
  featured    Boolean     @default(false)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([branchId])
  @@map("products")
}

// ─── SABORES ────────────────────────────────
model Flavor {
  id         String            @id @default(cuid())
  name       String
  available  Boolean           @default(true)
  order      Int               @default(0)
  branchId   String
  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderItems OrderItemFlavor[]

  @@unique([branchId, name])
  @@map("flavors")
}

// ─── PEDIDOS ────────────────────────────────
// status:        "CREADO" | "ESPERANDO_PAGO" | "PAGADO" | "PREPARANDO" | "LISTO" | "ENTREGADO" | "CANCELADO"
// deliveryType:  "DELIVERY" | "RETIRO"
// paymentMethod: "MERCADO_PAGO" | "TRANSFERENCIA" | "EFECTIVO"
model Order {
  id            String      @id @default(cuid())
  orderNumber   Int
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id])
  customerName  String
  customerPhone String
  address       String?
  deliveryType  String
  paymentMethod String
  status        String      @default("CREADO")
  subtotal      Float
  deliveryCost  Float       @default(0)
  total         Float
  notes         String?
  items         OrderItem[]
  payment       Payment?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([branchId, orderNumber])
  @@index([branchId])
  @@map("orders")
}

// ─── ÍTEMS DE PEDIDO ────────────────────────
model OrderItem {
  id        String            @id @default(cuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  quantity  Int               @default(1)
  unitPrice Float
  subtotal  Float
  flavors   OrderItemFlavor[]

  @@map("order_items")
}

// ─── SABORES POR ÍTEM ───────────────────────
model OrderItemFlavor {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  flavorId    String
  flavor      Flavor    @relation(fields: [flavorId], references: [id])

  @@map("order_item_flavors")
}

// ─── PAGOS ──────────────────────────────────
// status: "PENDIENTE" | "APROBADO" | "RECHAZADO" | "CANCELADO"
model Payment {
  id             String   @id @default(cuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  method         String
  status         String   @default("PENDIENTE")
  mpPreferenceId String?
  mpPaymentId    String?
  amount         Float
  transferAlias  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("payments")
}

// ─── CONFIGURACIÓN ──────────────────────────
model Setting {
  id       String @id @default(cuid())
  key      String
  value    String
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, key])
  @@map("settings")
}

// ─── PROMOCIONES ─────────────────────────────
model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  badge       String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId])
  @@map("promotions")
}
